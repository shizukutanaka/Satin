# Satin用 gitignore
__pycache__/
*.pyc
*.pyo
*.pyd
.DS_Store
.env
.cache
.idea/
.vscode/
*.log
*.bak
*.swp
# 配信用一時ファイルやキャッシュもここに追加可

# ランタイム生成キャッシュ(CacheManager)
main/config/cache/
config/cache/

# アバターイベント/会話ログ(ランタイム生成)
avatar_event_log.jsonl
*.jsonl.gz

# 好感度/関係性の状態(ランタイム生成)
config/mood.json
main/config/mood.json
config/mood_history.jsonl
main/config/mood_history.jsonl

# ユーザープロファイル(名前・好み: ランタイム生成の個人データ)
config/user_profile.json
main/config/user_profile.json

# 多重起動ガードの PID ロック（ランタイム生成）
config/satin.lock
main/config/satin.lock
